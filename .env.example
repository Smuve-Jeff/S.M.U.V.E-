NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
DB_NAME=dbname
JWT_SECRET=change-me-to-a-random-string
FRONTEND_URL=http://localhost:3000

# WebRTC ICE for S.M.U.V.E Live. STUN alone works on most home networks.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Static TURN fallback (any provider). Leave blank when Cloudflare TURN is set.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# Managed TURN: Cloudflare Realtime issues short-lived per-client credentials
# from a scoped TURN key. Create one at
# https://developers.cloudflare.com/realtime/turn/generate-credentials/
# and keep both values server-side only.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Lifetime of minted credentials, in seconds (60-172800).
TURN_TTL_SECONDS=3600
# Last-resort relay for deployments with no TURN credentials above: Open
# Relay (Metered) relays on 80/443, the ports corporate and mobile firewalls
# allow, so share-link viewers behind symmetric NAT still connect. Media stays
# DTLS-SRTP encrypted; the relay only forwards packets it cannot read. Shared
# and best effort (20 GB/month) - set off once managed credentials exist.
TURN_PUBLIC_FALLBACK=on
# Point these at your own relay (e.g. coturn) to keep media on your own
# infrastructure; blank uses the shared Open Relay endpoints.
TURN_PUBLIC_FALLBACK_URLS=
TURN_PUBLIC_FALLBACK_USERNAME=
TURN_PUBLIC_FALLBACK_CREDENTIAL=

# Cloudflare R2 (S3-compatible) media and project storage.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=

# Streaming account OAuth. Register these callback URLs in each provider's app
# console, then paste the app credentials here. Without them the connect
# buttons answer 503 instead of pretending to connect.
#   <API_PUBLIC_URL>/api/stream-accounts/twitch/callback
#   <API_PUBLIC_URL>/api/stream-accounts/youtube/callback
API_PUBLIC_URL=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Google Cloud OAuth client (YouTube). GOOGLE_* fallbacks are also accepted.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Optional 32-byte hex/base64 key for sealing stored tokens. Blank derives one
# from JWT_SECRET; rotating either one requires reconnecting accounts.
OAUTH_TOKEN_KEY=

# Broadcast push. Twitch and Kick only accept RTMP(S), which a browser cannot
# send, so the host publishes WHIP to a relay that pushes RTMP to the provider.
# Without MEDIA_RELAY_URL the PUSH buttons answer 503 and say so.
# The relay control API is two endpoints:
#   POST   {MEDIA_RELAY_URL}/sessions  { rtmpUrl, streamKey } -> { id, whipUrl }
#   DELETE {MEDIA_RELAY_URL}/sessions/:id
# relay/ in this repo implements it (MediaMTX WHIP ingest + supervised ffmpeg);
# see relay/README.md for its deployment, TLS and UDP requirements.
MEDIA_RELAY_URL=
MEDIA_RELAY_TOKEN=
# Twitch ingest base; the channel's stream key is appended by the relay.
TWITCH_RTMP_URL=rtmp://live.twitch.tv/app
