NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
DB_NAME=dbname
JWT_SECRET=change-me-to-a-random-string
FRONTEND_URL=http://localhost:3000

# WebRTC ICE for S.M.U.V.E Live. STUN alone works on most home networks.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Static TURN fallback (any provider). Leave blank when Cloudflare TURN is set.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# Managed TURN: Cloudflare Realtime issues short-lived per-client credentials
# from a scoped TURN key. Create one at
# https://developers.cloudflare.com/realtime/turn/generate-credentials/
# and keep both values server-side only.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Lifetime of minted credentials, in seconds (60-172800).
TURN_TTL_SECONDS=3600

# Cloudflare R2 (S3-compatible) media and project storage.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=
