{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "app": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "Build",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.json",
            "polyfills": ["src/polyfills.ts"],
            "allowedCommonJsDependencies": ["automation-events"],
            "assets": ["src/assets", "src/manifest.webmanifest"],
            "serviceWorker": "ngsw-config.json",
            "styles": [
              "src/styles.css",
              "node_modules/animate.css/animate.min.css"
            ],
            "optimization": {
              "scripts": true,
              "styles": true,
              "fonts": false
            },
            "outputHashing": "all",
            "sourceMap": false,
            "extractLicenses": true
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": true,
                "fonts": false
              },
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.75mb",
                  "maximumError": "2.5mb"
                }
              ]
            },
            "ghpages": {
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": true,
                "fonts": false
              },
              "baseHref": "./",
              "assets": ["src/assets"]
            },
            "development": {
              "optimization": false,
              "outputHashing": "none",
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "port": 4200,
            "host": "0.0.0.0",
            "allowedHosts": [
              "smuvejeffpresents.com",
              "www.smuvejeffpresents.com"
            ]
          },
          "configurations": {
            "production": {
              "buildTarget": "app:build:production"
            },
            "development": {
              "buildTarget": "app:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
