{
  "name": "cinema-engine",
  "version": "1.0.0",
  "description": "Media analysis for the S.M.U.V.E. Image & Video Lab: video metadata, thumbnails, sprite sheets and upload. Rendering lives in the app's canvas renderer.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "dev": "tsc --watch",
    "pretest": "npm run build",
    "test": "node --test test/smoke.test.cjs"
  },
  "keywords": [
    "cinema",
    "media-analysis",
    "thumbnails",
    "sprite-sheet",
    "upload"
  ],
  "author": "Freebuff",
  "license": "MIT",
  "dependencies": {
    "lodash": "^4.17.21",
    "onnxruntime-web": "^1.30.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.5",
    "jest": "^29.7.0",
    "typescript": "^5.3.3"
  }
}
