{
  "name": "s.m.u.v.e-2.0",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "install:legacy": "npm install --legacy-peer-deps",
    "dev": "ng serve --host 0.0.0.0 --port ${PORT:-4200} --configuration development",
    "build": "ng build",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "start": "serve -s Build/browser -l tcp://0.0.0.0:${PORT:-4200}",
    "preview": "npm run build && npm run start -- -l 4200",
    "test": "jest",
    "lint": "eslint src setup-jest.ts",
    "format": "prettier --write .",
    "deploy": "ng build --configuration=ghpages && cp Build/browser/index.html Build/browser/404.html && npx angular-cli-ghpages --dir=Build/browser",
    "cap:init": "cap init \"S.M.U.V.E.\" com.smuve.smuve2 --web-dir=Build/browser",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync android",
    "cap:copy:android": "cap copy android",
    "cap:open:android": "cap open android",
    "build:wasm": "bash scripts/build-wasm.sh"
  },
