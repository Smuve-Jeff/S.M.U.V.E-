{
  "name": "s.m.u.v.e-2.0",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [],
  "scripts": {
    "install:legacy": "npm install --legacy-peer-deps",
    "dev": "ng serve --host 0.0.0.0 --port ${PORT:-4200} --configuration development",
    "build": "ng build",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "start": "serve -s Build/browser -l tcp://0.0.0.0:${PORT:-4200}",
    "preview": "npm run build && npm run start -- -l 4200",
    "test": "jest",
    "lint": "eslint src setup-jest.ts",
    "format": "prettier --write .",
    "deploy": "ng build --configuration=ghpages && cp Build/browser/index.html Build/browser/404.html && npx angular-cli-ghpages --dir=Build/browser",
    "deploy:render": "bash scripts/render-deploy.sh",
    "cap:init": "cap init \"S.M.U.V.E.\" com.smuve.smuve2 --web-dir=Build/browser",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync android",
    "cap:copy:android": "cap copy android",
    "cap:open:android": "cap open android",
    "cap:add:electron": "cap add @capacitor-community/electron",
    "cap:copy:electron": "cap copy @capacitor-community/electron",
    "cap:sync:electron": "cap sync @capacitor-community/electron",
    "cap:open:electron": "cap open @capacitor-community/electron",
    "electron:start": "npm run build && cap copy @capacitor-community/electron && cd electron && npm run electron:start",
    "build:wasm": "bash scripts/build-wasm.sh",
    "dev:server": "ts-node-dev --require tsconfig-paths/register --env-file=.env --respawn src/index.ts",
    "typeorm": "ts-node-dev --require tsconfig-paths/register --env-file=.env ./node_modules/typeorm/cli.js",
    "mg:gen": "npx typeorm -- migration:generate -d src/database/data-source.ts",
    "mg:create": "npm run typeorm -- migration:create",
    "mg:run": "npx typeorm -- migration:run -d src/database/data-source.ts",
    "mg:run:prod": "typeorm migration:run -d dist/database/data-source.js",
    "mg:revert": "npx typeorm -- migration:revert -d src/database/data-source.ts",
    "mg:show": "npx typeorm -- migration:show -d src/database/data-source.ts"
  },
  "dependencies": {
    "@angular-devkit/build-angular": "21.2.7",
    "@angular/animations": "21.2.9",
    "@angular/cli": "21.2.7",
    "@angular/common": "21.2.9",
    "@angular/compiler": "21.2.9",
    "@angular/compiler-cli": "21.2.9",
    "@angular/core": "21.2.9",
    "@angular/forms": "21.2.9",
    "@angular/platform-browser": "21.2.9",
    "@angular/platform-browser-dynamic": "21.2.9",
    "@angular/router": "21.2.9",
    "@angular/service-worker": "21.2.9",
    "@aws-sdk/client-s3": "^3.1085.0",
    "@capacitor-community/electron": "^5.0.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@google/genai": "^1.48.0",
    "animate.css": "^4.1.1",
    "autoprefixer": "^10.5.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "onnxruntime-web": "^1.19.2",
    "pg": "^8.22.0",
    "playwright": "^1.59.1",
    "postcss": "^8.5.10",
