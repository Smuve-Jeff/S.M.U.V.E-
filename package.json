{
  "name": "smuve-cinema-deploy",
  "private": true,
  "version": "1.0.0",
  "description": "Web entry point that builds and serves the cinema-engine package",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "install:legacy": "npm --prefix cinema-engine ci --include=dev",
    "build": "npm --prefix cinema-engine run build",
    "build:server": "node --check server.js",
    "start:unified": "node server.js",
    "start": "node server.js",
    "dev": "npm --prefix cinema-engine run dev",
    "test": "npm --prefix cinema-engine test"
  }
}
