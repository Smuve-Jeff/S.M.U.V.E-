    "rxjs": "^7.8.2",
    "serve": "^14.2.6",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^3.4.17",
    "tone": "^15.1.22",
    "typeorm": "^1.1.0",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.5",
    "zod": "^4.4.3",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular/pwa": "21.2.7",
    "@babel/preset-typescript": "^7.28.5",
    "@capacitor/cli": "^8.5.0",
    "@playwright/test": "^1.59.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
